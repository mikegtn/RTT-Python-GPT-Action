[Unit]
Description=Realtime Trains MCP adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/rtt-mcp/current
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/rtt-action.env
Environment=MCP_ASSET_BASE_URL=https://rail.mikegtn.net/mcp/assets
Environment=MCP_USAGE_FILE=/var/lib/rtt-mcp/usage.json
Environment=MCP_MAP_DIR=/var/lib/rtt-mcp/maps
Environment=MOVEBOOK_ROUTE_SCRIPT=/var/www/html/scripts/route_movebook_draft.py
Environment=OAUTH_DATABASE=/var/lib/rtt-mcp/oauth.sqlite3
Environment=OAUTH_BRIDGE_KEY_FILE=/etc/rtt-oauth-bridge.key
Environment=MCP_PROGRESS_IMAGE_DIR=/var/lib/rtt-mcp/progress-images
StateDirectory=rtt-mcp
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/rtt-mcp/current/.venv/bin/python -m rtt_app.mcp_server --transport http --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
