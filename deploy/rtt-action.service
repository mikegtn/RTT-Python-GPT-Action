[Unit]
Description=Realtime Trains GPT Action API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/rtt-action
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/rtt-action.env
Environment=ACTION_USAGE_FILE=/var/lib/rtt-action/usage.json
Environment=ACTION_MAP_DIR=/var/lib/rtt-action/maps
Environment=MOVEBOOK_ROUTE_SCRIPT=/var/www/html/scripts/route_movebook_draft.py
StateDirectory=rtt-action
ExecStart=/usr/bin/python3 -m rtt_app.action_api --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
