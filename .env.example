# Copy this file to .env, then paste the token shown by the RTT API portal.
# The app reads .env automatically but never commits it.
RTT_TOKEN=replace-with-your-access-or-refresh-token

# Required only by the conversational Rail Assistant.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.4

# ChatGPT GPT Action bridge. Generate a long random value; do not reuse RTT_TOKEN.
ACTION_API_KEY=replace-with-a-long-random-action-key
# Public HTTPS origin after deployment/tunnelling, without a trailing slash.
ACTION_BASE_URL=https://your-action-host.example
# ACTION_HOST=127.0.0.1
# ACTION_PORT=8765

# Optional overrides
RTT_BASE_URL=https://data.rtt.io
# RTT_API_VERSION=2026-04-09
# RTT_TOKEN_TYPE=auto
